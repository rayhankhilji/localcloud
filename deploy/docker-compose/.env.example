# Copy to .env and fill in.

# Tunnels are served at https://<id>.$LOCALCLOUD_DOMAIN, the relay itself at
# https://$LOCALCLOUD_DOMAIN. Both the name and *.name must resolve to this host.
LOCALCLOUD_DOMAIN=tunnel.example.com

# Let's Encrypt account email (expiry notices, rate-limit contact).
ACME_EMAIL=you@example.com

# Optional: require clients to send this as LOCALCLOUD_TOKEN.
# Generate one with: openssl rand -hex 24
LOCALCLOUD_RELAY_TOKEN=
