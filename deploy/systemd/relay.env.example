# /etc/localcloud/relay.env — read by localcloud-relay.service.
# Every variable is documented in docs/self-hosting.md#configuration-reference.

# Tunnels at https://<id>.tunnel.example.com (needs *.tunnel.example.com DNS + certificate).
# Leave unset for cookie routing on a single hostname.
LOCALCLOUD_DOMAIN=tunnel.example.com

# Require clients to send this as LOCALCLOUD_TOKEN. openssl rand -hex 24
#LOCALCLOUD_RELAY_TOKEN=

# Listen address. Keep 127.0.0.1 when a reverse proxy runs on the same host.
#HOST=127.0.0.1
#PORT=8080
